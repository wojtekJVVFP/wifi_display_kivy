#:kivy 1.0

<ImageScr>:
    image: image

    FloatLayout:
        Image:
            id: image
            fit_mode: 'contain' # fill rozciąga do rozmiaru widżetu,contain zmienia rozmiar zachowując jednocześnie proporcje obrazu
            source: 'obrazy/linie.jpg'
            size_hint: (1,1)
            on_touch_down:
                root.manager.transition.direction = 'left'
                root.manager.current = 'settingsScreen'

<SettingsScr>:
    button: button1 #name from py: id from kv file, the name can be the same as id
    ip_address: ip_address
    display_res: display_res
    display_dpi: display_dpi
    on_size: root.reposition()
    on_pos: root.reposition()

    GridLayout:
        cols: 2
        Label:
            text: 'IP address: '
        Label:
            id: ip_address
            text: 'N/A'
        Label:
            text: 'display res x, y: '
        Label:
            id: display_res
            text: 'N/A'
        Label:
            text: 'display dpi x,y: '
        Label:
            id: display_dpi
            text: 'N/A'
        Button:
            text: 'image screen'
            on_press:
                root.manager.transition.direction = 'right'
                root.manager.current = 'imageScreen'
        Button:
            id: button1
            text: 'button'
        Button:
            text: 'End app'
            on_press: app.stop()




